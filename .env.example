# Copy to .env and adjust. `pnpm dev` loads it; other commands read these variables from the environment.
# Every app setting is prefixed POIETIC_ISSUES_.

# Database: the URL scheme selects the dialect.
#   sqlite:./data/dev.db            (development default)
#   postgres://user:pass@host/db    (production)
POIETIC_ISSUES_DATABASE_URL=sqlite:./data/dev.db

# Tests: which dialect the shared suites run against, and the Postgres URL used when TEST_DB=postgres.
# `pnpm pg start` prints a matching URL for the local throwaway cluster.
TEST_DB=sqlite
TEST_DATABASE_URL=postgres://tracker@127.0.0.1:54329/tracker

# Server settings (all optional in development; see docs/deployment.md for the full list):
# POIETIC_ISSUES_PORT=3000
# POIETIC_ISSUES_LOG_FORMAT=pretty          # or json
# POIETIC_ISSUES_BLOB_STORE=local           # or s3 (with POIETIC_ISSUES_S3_ENDPOINT, _BUCKET, _ACCESS_KEY_ID, _SECRET_ACCESS_KEY)
# POIETIC_ISSUES_WEBHOOK_ALLOW_PRIVATE=1    # development default; lets webhooks call localhost receivers
